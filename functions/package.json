{
  "name": "roprofit-functions",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test --experimental-strip-types src/**/*.test.ts",
    "grant-admin": "node --experimental-strip-types scripts/grant-admin.ts",
    "check:contract": "node scripts/contract-check.cjs",
    "check:score": "node scripts/score-check.cjs",
    "check:sim": "node scripts/sim-check.cjs",
    "check:e2e": "node scripts/e2e-check.cjs",
    "check:pipeline": "node scripts/pipeline-check.cjs",
    "check:batches": "node scripts/batch-real-check.cjs",
    "check:writes": "node scripts/writes-check.cjs"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~5.9.3"
  }
}
