{
  "name": "roprofit-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && cp src/db/schema.sql dist/db/schema.sql",
    "start": "node dist/index.js",
    "dev": "tsc --watch & node --watch dist/index.js",
    "migrate": "node dist/db/migrate-cli.js",
    "grant-admin": "node dist/cli/grant-admin.js",
    "check:pg": "node scripts/pg-check.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "firebase-admin": "^13.6.0",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.15.5",
    "typescript": "~5.9.3"
  }
}
